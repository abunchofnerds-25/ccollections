.TH CHTTP_STATUS_* 3 "2026-07-10" "c_collections" "C Collections Library - Macros"
.SH NAME
CHTTP_STATUS_* \- HTTP status code constants
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <chttp.h>

CHTTP_STATUS_CONTINUE               100
CHTTP_STATUS_SWITCHING_PROTOCOLS    101
CHTTP_STATUS_OK                     200
CHTTP_STATUS_CREATED                201
CHTTP_STATUS_ACCEPTED               202
CHTTP_STATUS_NO_CONTENT             204
CHTTP_STATUS_MOVED_PERMANENTLY      301
CHTTP_STATUS_FOUND                  302
CHTTP_STATUS_NOT_MODIFIED           304
CHTTP_STATUS_TEMPORARY_REDIRECT     307
CHTTP_STATUS_PERMANENT_REDIRECT     308
CHTTP_STATUS_BAD_REQUEST            400
CHTTP_STATUS_UNAUTHORIZED           401
CHTTP_STATUS_FORBIDDEN              403
CHTTP_STATUS_NOT_FOUND              404
CHTTP_STATUS_METHOD_NOT_ALLOWED     405
CHTTP_STATUS_CONFLICT               409
CHTTP_STATUS_GONE                   410
CHTTP_STATUS_UNPROCESSABLE_ENTITY   422
CHTTP_STATUS_TOO_MANY_REQUESTS      429
CHTTP_STATUS_INTERNAL_SERVER_ERROR  500
CHTTP_STATUS_NOT_IMPLEMENTED        501
CHTTP_STATUS_BAD_GATEWAY            502
CHTTP_STATUS_SERVICE_UNAVAILABLE    503
CHTTP_STATUS_GATEWAY_TIMEOUT        504
.fi
.SH DESCRIPTION
.nf
Integer constants for common HTTP status codes.  Prefer these names
over bare integer literals to improve readability.
.fi
.SH EXAMPLES
.nf
if (resp->status_code == CHTTP_STATUS_NOT_FOUND) { ... }
.fi
.SH "SEE ALSO"
.BR chttpclient_do (3),
.BR chttpcli_response (3)
