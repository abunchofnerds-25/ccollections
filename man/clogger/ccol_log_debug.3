.TH CCOL_LOG_DEBUG 3 "2026-07-10" "c_collections" "C Collections Library - Macros"
.SH NAME
clog_debug \- emit a log line at DEBUG level
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/clogger.h>

clog_debug(clog lg, const char *fmt, ...);
.fi
.SH DESCRIPTION
.nf
Writes a log line at CLOG_DEBUG level, capturing __FILE__, __LINE__
and __func__ by itself.  No backtrace is appended.
.fi
.SH PARAMETERS
.nf
lg     Logger handle (clog).
fmt    printf-style format string.
\&...    Format arguments (optional).
.fi
.SH EXAMPLES
.nf
clog_debug(lg, "cache miss for key=%d", key);
.fi
.SH "SEE ALSO"
.BR clog_trace (3),
.BR clog_info (3),
.BR clog_warn (3),
.BR clog_error (3),
.BR clog_alert (3),
.BR clog_fatal (3)
