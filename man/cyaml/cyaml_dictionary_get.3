.TH CYAML_DICTIONARY_GET 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
cyaml_dictionary_get \- look up a key in a dictionary
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/cyaml.h>

cyaml cyaml_dictionary_get(cyaml map, const char *key);
.fi
.SH DESCRIPTION
.nf
Returns the value that map stores under key.  The dictionary keeps
owning the value, so the reference is borrowed.
.fi
.SH RETURN VALUE
.nf
The child node, or NULL when map has no such key or is not a
CYAML_DICTIONARY.
.fi
.SH "SEE ALSO"
.BR cyaml_dictionary_set (3),
.BR cyaml_dictionary_first (3),
.BR cyaml_dictionary_size (3)
