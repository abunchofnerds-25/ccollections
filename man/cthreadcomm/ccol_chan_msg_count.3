.TH CCOL_CHAN_MSG_COUNT 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
ccol_chan_msg_count \- get current message count for a direction
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <cthreadcomm.h>

size_t ccol_chan_msg_count(ccol_channel *ch, ccol_channel_direction d);
.fi
.SH DESCRIPTION
.nf
Returns the number of messages currently stored in the specified direction's
queue.
.fi
.SH PARAMETERS
.nf
ch   Channel to query
d    Direction to query (ccol_owner_to_workers or ccol_workers_to_owner)
.fi
.SH RETURN VALUE
.nf
Returns number of messages in the specified direction
Returns (size_t)-1 on error (NULL ccol_channel or invalid direction)
.fi
.SH NOTES
.nf
Thread-safe snapshot of message count
.fi
.SH "SEE ALSO"
.BR ccol_chan_send_zc (3),
.BR ccol_chan_recv_zc (3)
