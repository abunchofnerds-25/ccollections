.TH CLRU_CONSTRUCT_SCOPED 3 "2026-08-02" "c_collections" "C Collections Library - Macros"
.SH NAME
clru_construct_scoped \- declare and initialise an LRU cache that is destroyed at scope exit
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/clrucache.h>

clru_construct_scoped(name, KeyT, ValT, capacity, getter, setter,
                      evict_cb);
.fi
.SH DESCRIPTION
.nf
This macro does what clru_construct() does. It also destroys the cache
automatically when the variable leaves its scope.
.fi
.SH PARAMETERS
.nf
name      Variable name for the cache handle
KeyT      Key type
ValT      Value type
capacity  The maximum number of live entries before eviction
getter    Remote getter callback, or NULL
setter    Remote setter callback, or NULL
evict_cb  Eviction callback, or NULL
.fi
.SH NOTES
.nf
This macro needs GCC or Clang, because it uses __attribute__((cleanup)).
.fi
.SH EXAMPLES
.nf
void process(void) {
    clru_construct_scoped(cache, int, double, 64, NULL, NULL, NULL);
    /* the cache is destroyed automatically when process() returns */
}
.fi
.SH "SEE ALSO"
.BR clru_construct (3),
.BR clru_declare_scoped (3)
