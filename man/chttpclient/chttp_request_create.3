.TH CHTTP_REQUEST_CREATE 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
chttp_request_create \- allocate and initialize an HTTP request (default allocator)
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/chttpclient.h>

chttp_request_t *chttp_request_create(chttp_method_t method,
                                      const char *url,
                                      const chttp_request_body_t *body,
                                      char **err_str);
.fi
.SH DESCRIPTION
.nf
This is an inline wrapper around chttp_request_create_mp that passes NULL
for mprocs.
.fi
.SH RETURN VALUE
.nf
A pointer to the new request, or NULL if the call fails. It fails for
a NULL url, for a method that names no HTTP method (CHTTP_ANY
included), for a NULL body->data with a body->len that is not zero,
and when an allocation fails. See chttp_request_create_mp(3).
.fi
.SH "SEE ALSO"
.BR chttp_request_create_mp (3)
