.TH CTPOOL_ACTIVE_COUNT 3 "2026-08-02" "c_collections" "C Collections Library - Functions"
.SH NAME
ctpool_active_count \- number of tasks that run now
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/cthreadpool.h>

size_t ctpool_active_count(ctpool pool);
.fi
.SH DESCRIPTION
.nf
Returns a snapshot of how many tasks the worker threads are running at
the moment, that is, tasks that a worker has taken out of the queue
and that have not finished yet. The value can change as soon as the
call returns.
.fi
.SH PARAMETERS
.nf
pool   Thread pool handle. CTPOOL_NULL, or a stale or
       already-destroyed handle, gives 0.
.fi
.SH RETURN VALUE
.nf
The number of tasks running at the moment, or 0 if pool is
CTPOOL_NULL or a stale or already-destroyed handle.
.fi
.SH "SEE ALSO"
.BR ctpool_pending_count (3)
