.TH CCOL_LOG_DEBUG 3 "2026-07-10" "c_collections" "C Collections Library - Macros"
.SH NAME
ccol_log_debug \- emit a log line at DEBUG level
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/clogger.h>

ccol_log_debug(clog lg, const char *fmt, ...);
.fi
.SH DESCRIPTION
.nf
Writes a log line at CLOG_DEBUG level.  It captures __FILE__, __LINE__
and __func__ by itself.  It appends no backtrace.
.fi
.SH PARAMETERS
.nf
lg     Logger handle (clog).
fmt    printf-style format string.
\&...    Format arguments (optional).
.fi
.SH EXAMPLES
.nf
ccol_log_debug(lg, "cache miss for key=%d", key);
.fi
.SH "SEE ALSO"
.BR ccol_log_trace (3),
.BR ccol_log_info (3),
.BR ccol_log_warn (3),
.BR ccol_log_error (3),
.BR ccol_log_alert (3),
.BR ccol_log_fatal (3)
