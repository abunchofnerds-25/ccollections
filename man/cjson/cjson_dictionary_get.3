.TH CJSON_DICTIONARY_GET 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
cjson_dictionary_get \- look up a key in an object node
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/cjson.h>

cjson cjson_dictionary_get(cjson obj, const char *key);
.fi
.SH DESCRIPTION
.nf
Returns the value stored under key in obj.  The object keeps owning
the value, so the reference is borrowed.
.fi
.SH RETURN VALUE
.nf
The child node, or NULL when obj has no such key or is not a
CJSON_DICTIONARY.
.fi
.SH "SEE ALSO"
.BR cjson_dictionary_first (3),
.BR cjson_dictionary_set (3),
.BR cjson_dictionary_size (3)
