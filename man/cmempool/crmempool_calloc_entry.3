.TH CRMEMPOOL_CALLOC_ENTRY 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
crmempool_calloc_entry \- allocate zero-initialized entry
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/cmempool.h>

void *crmempool_calloc_entry(crmempool *rmp, size_t size);
.fi
.SH DESCRIPTION
.nf
The same as crmempool_alloc_entry(), except that the requested
number of bytes is set to zero before the entry is returned.
.fi
.SH PARAMETERS
.nf
rmp   Ranged memory pool to allocate from
size  Size in bytes to allocate
.fi
.SH RETURN VALUE
.nf
Returns a pointer to the zeroed entry on success
Returns NULL on failure
.fi
.SH NOTES
.nf
Exactly 'size' bytes are zeroed, not the full pool element
Thread-safe if the pool was created with single_threaded=false
The function asserts if rmp is NULL
.fi
.SH "SEE ALSO"
.BR crmempool_alloc_entry (3),
.BR crmempool_realloc_entry (3)
