.TH CSTRING_COPY 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
cstring_copy \- create an independent copy of a string
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/cstring.h>

cstr cstring_copy(cstr s, char **err);
.fi
.SH DESCRIPTION
.nf
This function allocates a new cstring with the same content as s; after the
call, the two strings are fully independent.
.fi
.SH PARAMETERS
.nf
s     String to copy
err   Optional pointer to receive an error string on failure
.fi
.SH RETURN VALUE
.nf
A new cstring on success
NULL when an allocation fails, in which case the function writes the details
to *err if err is not NULL
.fi
.SH NOTES
.nf
Caller must destroy the returned cstring when done
Asserts if s is NULL
.fi
.SH "SEE ALSO"
.BR cstring_substring (3),
.BR cstring_create (3)
