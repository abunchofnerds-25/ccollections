.TH CLOG_GET_FORMAT 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
clog_get_format \- return the current output format
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <clogger.h>

clog_format_t clog_get_format(clog logger);
.fi
.SH DESCRIPTION
.nf
Returns the current output format of the shared backing store.
.fi
.SH PARAMETERS
.nf
logger  Logger handle.
.fi
.SH RETURN VALUE
.nf
CLOG_FMT_LOGFMT, CLOG_FMT_JSON, or CLOG_FMT_SYSLOG.
.fi
.SH NOTES
.nf
Thread-safe: protected by the shared backing-store mutex.
.fi
.SH "SEE ALSO"
.BR clog_set_format (3),
.BR clog_set_facility (3)
