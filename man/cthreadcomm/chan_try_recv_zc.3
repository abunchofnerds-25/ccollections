.TH CHAN_TRY_RECV_ZC 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
chan_try_recv_zc \- try to receive without blocking
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <cthreadcomm.h>

ccol_retval_t chan_try_recv_zc(channel *ch, c_message_t *target_buf);
.fi
.SH DESCRIPTION
.nf
Attempts to receive immediately from the automatically-selected queue.
Returns immediately if the queue is empty.
.fi
.SH PARAMETERS
.nf
ch          Channel to receive from
target_buf  Buffer to receive the message
.fi
.SH RETURN VALUE
.nf
ccol_success         - Message received (caller must free target_buf->data)
ccol_invalid_args    - ch or target_buf is NULL
ccol_container_empty - Selected queue is empty
.fi
.SH NOTES
.nf
Never blocks
Direction is automatically determined by thread ID
.fi
.SH "SEE ALSO"
.BR chan_recv_zc (3),
.BR chan_timed_recv_zc (3)
