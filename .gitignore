.vscode/
.zed/
.project
obj/
# Build products. Every pattern here starts with a slash, which ties it to the
# root of the repository, so it only matches what a `make` in the root makes.
# Drop the slash and the pattern matches at every level, and then
# libccollections.so.* would also hide the ABI baselines we commit under abi/.
/libccollections.so
# The versioned shared objects, libccollections.so.<ABI> and
# libccollections.so.<VERSION>
/libccollections.so.*
/libccollections.a
# Generated from ccollections.pc.in with the prefix and the version filled in.
# Only the .in template is committed.
/ccollections.pc
/ccollections.pc.tmp
tests/*/tests
tests/*/tests_*
!tests/*/tests_*.*
tests/*/coverage/
# The merged coverage report of `make coverage_site`, for reading in a
# browser.
coverage_site/
# The HTML man pages of `make man_html`, and the GitHub Pages site that the
# Coverage workflow puts together from them and the coverage report.
/man_html/
/pages_site/
tests/*/fuzz_*
tests/*/crash-*
tests/*/oom-*
tests/*/timeout-*
__pycache__/
tests/cyaml/differential/cyaml_to_json
# libFuzzer writes every new corpus entry it finds back into the corpus
# directory, named by a plain hash with no extension. We only commit the seeds
# we picked on purpose: the *.bin files, plus the *.yaml files of cyaml's
# document corpus. cyaml's path corpus has a NUL inside each input, so its
# seeds are *.bin, like the matching cjson corpus.
tests/chttpclient/fuzz/corpus_request/*
!tests/chttpclient/fuzz/corpus_request/*.bin
tests/chttpclient/fuzz/corpus_response/*
!tests/chttpclient/fuzz/corpus_response/*.bin
tests/chttpclient/fuzz/corpus_url/*
!tests/chttpclient/fuzz/corpus_url/*.bin
tests/cjson/fuzz/corpus_parse/*
!tests/cjson/fuzz/corpus_parse/*.bin
tests/cjson/fuzz/corpus_path/*
!tests/cjson/fuzz/corpus_path/*.bin
tests/cyaml/fuzz/corpus/*
!tests/cyaml/fuzz/corpus/*.yaml
tests/cyaml/fuzz/corpus_path/*
!tests/cyaml/fuzz/corpus_path/*.bin
*.gcno
*.gcda
*.gcov
*.c.info
*.o
main
/*.pdb
.envrc
massif.out.*

# Each suite's build identity stamp, which records the compiler and the flags
# its objects were built with.
tests/*/.build-flags

# Benchmark build products. baseline.json stays out of version control on
# purpose: it holds absolute times for one machine, and a run compared with a
# baseline from other hardware reports differences that have nothing to do
# with the library.
/bench/bench
/bench/baseline.json
/bench/.build-flags

# The build identity stamp of clogger's consumer view translation unit
tests/*/.build-flags-consumer

# A line with no side effects. It starts a new CI run - 1
