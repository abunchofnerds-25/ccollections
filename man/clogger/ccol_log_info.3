.TH CCOL_LOG_INFO 3 "2026-07-10" "c_collections" "C Collections Library - Macros"
.SH NAME
ccol_log_info \- emit a log line at INFO level
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/clogger.h>

ccol_log_info(clog lg, const char *fmt, ...);
.fi
.SH DESCRIPTION
.nf
Writes a log line at CLOG_INFO level.  It captures __FILE__, __LINE__
and __func__ by itself.  It appends no backtrace.

INFO is the recommended default minimum level for production services.
.fi
.SH PARAMETERS
.nf
lg     Logger handle (clog).
fmt    printf-style format string.
\&...    Format arguments (optional).
.fi
.SH EXAMPLES
.nf
ccol_log_info(lg, "server started on port %d", port);
ccol_log_info(lg, "request handled in %ldms", elapsed_ms);
.fi
.SH "SEE ALSO"
.BR ccol_log_trace (3),
.BR ccol_log_debug (3),
.BR ccol_log_warn (3),
.BR ccol_log_error (3),
.BR ccol_log_alert (3),
.BR ccol_log_fatal (3)
