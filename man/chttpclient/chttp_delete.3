.TH CHTTP_DELETE 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
chttp_delete \- do a DELETE request with the default client
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/chttpclient.h>

ccol_retval chttp_delete(const char *url,
                           chttpcli_response **resp_out);
.fi
.SH DESCRIPTION
.nf
This is a convenience wrapper that sends an HTTP DELETE.
.fi
.SH RETURN VALUE
.nf
The same codes as chttpcli_do.
.fi
.SH "SEE ALSO"
.BR chttp_get (3),
.BR chttp_do_default (3)
