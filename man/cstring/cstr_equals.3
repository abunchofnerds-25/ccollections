.TH CSTR_EQUALS 3 "2026-07-10" "c_collections" "C Collections Library - Macros"
.SH NAME
cstr_equals \- check whether the string equals a C string
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <cstring.h>

cstr_equals(s, str);
.fi
.SH DESCRIPTION
.nf
Pass-through wrapper for cstring_equals().
.fi
.SH PARAMETERS
.nf
s     cstr to compare
str   C string to compare against
.fi
.SH RETURN VALUE
.nf
true if contents are equal, false otherwise
.fi
.SH "SEE ALSO"
.BR cstring_equals (3),
.BR cstr_compare (3)
