.vscode/
.project
obj/
# These are build products. Each pattern starts with a slash, which ties it to
# the root of the repository. The patterns therefore describe only what a
# `make` in the root makes. Without that slash, a pattern matches at every
# level, and libccollections.so.* would then also hide the committed ABI
# baselines under abi/.
/libccollections.so
# The shared objects with a version in the name: libccollections.so.<ABI> and
# libccollections.so.<VERSION>
/libccollections.so.*
/libccollections.a
# The build makes this file from ccollections.pc.in and puts the prefix and the
# version into it. Only the .in template is under version control.
/ccollections.pc
/ccollections.pc.tmp
tests/*/tests
tests/*/tests_*
!tests/*/tests_*.*
tests/*/coverage/
# The merged coverage report that `make coverage_site` makes. You can read it
# in a browser.
coverage_site/
tests/*/fuzz_*
tests/*/crash-*
tests/*/oom-*
tests/*/timeout-*
__pycache__/
tests/cyaml/differential/cyaml_to_json
# libFuzzer finds new corpus entries and writes them back into the corpus
# directory that you give it. It names each one with a plain hash and no
# extension. Commit only the seed files that somebody took out on purpose.
# Those are the *.bin files, and the *.yaml files for the document corpus of
# cyaml. The path corpus of cyaml carries a NUL inside each input, so its
# seeds are *.bin like the matching corpus of cjson.
tests/chttpclient/fuzz/corpus_request/*
!tests/chttpclient/fuzz/corpus_request/*.bin
tests/chttpclient/fuzz/corpus_response/*
!tests/chttpclient/fuzz/corpus_response/*.bin
tests/chttpclient/fuzz/corpus_url/*
!tests/chttpclient/fuzz/corpus_url/*.bin
tests/cjson/fuzz/corpus_parse/*
!tests/cjson/fuzz/corpus_parse/*.bin
tests/cjson/fuzz/corpus_path/*
!tests/cjson/fuzz/corpus_path/*.bin
tests/cyaml/fuzz/corpus/*
!tests/cyaml/fuzz/corpus/*.yaml
tests/cyaml/fuzz/corpus_path/*
!tests/cyaml/fuzz/corpus_path/*.bin
*.gcno
*.gcda
*.gcov
*.c.info
*.o
main
/*.pdb
.envrc
massif.out.*

# The build identity stamp of each suite. It holds the compiler and the flags
# that the build used for the objects.
tests/*/.build-flags

# These are the build products of the benchmarks. baseline.json is not under
# version control, on purpose. It records absolute times for one machine. A
# comparison of a run against a baseline from other hardware therefore reports
# a difference that has nothing to do with a change to the library.
/bench/bench
/bench/baseline.json
/bench/.build-flags

# The build identity stamp for the consumer view translation unit of clogger
tests/*/.build-flags-consumer

# The hardening-flag probe of the root Makefile and of tests/hardening.mk
# writes these while it asks the compiler what it supports, and removes them
# again. An interrupted build can leave one behind.
.ccol_probe.c
.ccol_probe.o

# A line with no side effects. It starts a new CI run - 0

