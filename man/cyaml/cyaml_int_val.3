.TH CYAML_INT_VAL 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
cyaml_int_val \- extract an integer value from a CYAML_INTEGER node
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <cyaml.h>

long long cyaml_int_val(cyaml node);
.fi
.SH DESCRIPTION
.nf
Return the long long stored in node.  Calls fatal_err() if node is NULL
or if its type is not CYAML_INTEGER.
.fi
.SH PARAMETERS
.nf
node  CYAML_INTEGER node.
.fi
.SH RETURN VALUE
.nf
long long value.
.fi
.SH "SEE ALSO"
.BR cyaml_type (3),
.BR cyaml_create_int (3)
