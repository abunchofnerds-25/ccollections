.TH CSTRING_EQUALS 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
cstring_equals \- check whether the string equals a C string
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <cstring.h>

bool cstring_equals(cstr s, const char *str);
.fi
.SH DESCRIPTION
.nf
Returns true if and only if the content of s is identical to str.
.fi
.SH PARAMETERS
.nf
s     String to compare
str   C string to compare against
.fi
.SH RETURN VALUE
.nf
true if contents are equal, false otherwise
.fi
.SH NOTES
.nf
Asserts if s is NULL
.fi
.SH "SEE ALSO"
.BR cstring_compare (3),
.BR cstring_starts_with (3),
.BR cstring_ends_with (3)
