.BR cbmap_construct_full_scoped (3),
.BR cbmap_init_full (3),
.BR cbmap_declare (3),
.BR cbmap_redeclare (3),
.BR cbmap_begin_iter (3),
.BR cbmap_create_full (3),
.BR cbmap_destroy (3)
