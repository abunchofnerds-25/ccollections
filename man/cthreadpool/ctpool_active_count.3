.TH CTPOOL_ACTIVE_COUNT 3 "2026-08-02" "c_collections" "C Collections Library - Functions"
.SH NAME
ctpool_active_count \- number of tasks that run now
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/cthreadpool.h>

size_t ctpool_active_count(ctpool pool);
.fi
.SH DESCRIPTION
.nf
Returns a snapshot of the number of tasks that the worker threads run
now. A worker took each of these tasks out of the queue, and none of
them finished yet. The value can change immediately after the call
returns.
.fi
.SH PARAMETERS
.nf
pool   Thread pool handle. CTPOOL_INVALID, or a stale or
       already-destroyed handle, gives 0.
.fi
.SH RETURN VALUE
.nf
The number of tasks that run now. It is 0 if pool is CTPOOL_INVALID,
or a stale or already-destroyed handle.
.fi
.SH "SEE ALSO"
.BR ctpool_pending_count (3)
