.TH LOG_DEBUG 3 "2026-07-10" "c_collections" "C Collections Library - Macros"
.SH NAME
log_debug \- emit a log line at DEBUG level
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <clogger.h>

log_debug(clog lg, const char *fmt, ...);
.fi
.SH DESCRIPTION
.nf
Expands to a call to _clog_write() at CLOG_DEBUG level with automatic
source location capture. No backtrace is appended.
.fi
.SH PARAMETERS
.nf
lg     Logger handle (clog).
fmt    printf-style format string.
\&...    Format arguments (optional).
.fi
.SH EXAMPLES
.nf
log_debug(lg, "cache miss for key=%d", key);
.fi
.SH "SEE ALSO"
.BR log_trace (3),
.BR log_info (3),
.BR log_warn (3),
.BR log_error (3),
.BR log_alert (3),
.BR log_fatal (3),
.BR _clog_write (3)
