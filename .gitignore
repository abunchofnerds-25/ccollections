.vscode/
.project
obj/
# Build artefacts, anchored to the repository root with a leading slash so
# that these patterns describe only the products of a root `make`. Unanchored,
# they match at every level, and libccollections.so.* would then also swallow
# the committed ABI baselines under abi/.
/libccollections.so
# versioned shared objects: libccollections.so.<ABI> and .<VERSION>
/libccollections.so.*
/libccollections.a
# generated from ccollections.pc.in at build time (prefix/version are
# substituted in), so only the .in template is tracked
/ccollections.pc
/ccollections.pc.tmp
tests/*/tests
tests/*/tests_*
!tests/*/tests_*.*
tests/*/coverage/
# merged, browsable coverage report produced by `make coverage_site`
coverage_site/
tests/*/fuzz_*
tests/*/crash-*
tests/*/oom-*
tests/*/timeout-*
__pycache__/
tests/cyaml/differential/cyaml_to_json
# libFuzzer auto-discovers and writes new corpus entries (bare-hash
# filenames, no extension) back into whatever corpus directory it's
# pointed at; only the deliberately-extracted seed files (*.bin, or *.yaml
# for cyaml) should be committed.
tests/chttpclient/fuzz/corpus_request/*
!tests/chttpclient/fuzz/corpus_request/*.bin
tests/chttpclient/fuzz/corpus_response/*
!tests/chttpclient/fuzz/corpus_response/*.bin
tests/cjson/fuzz/corpus_parse/*
!tests/cjson/fuzz/corpus_parse/*.bin
tests/cjson/fuzz/corpus_path/*
!tests/cjson/fuzz/corpus_path/*.bin
tests/cyaml/fuzz/corpus/*
!tests/cyaml/fuzz/corpus/*.yaml
*.gcno
*.gcda
*.gcov
*.c.info
*.o
main
/*.pdb
.envrc
massif.out.*

# Per-suite build-identity stamps (compiler + flags the objects were built with)
tests/*/.build-flags

# Benchmark build products. baseline.json is deliberately not committed: it
# records absolute timings for one machine, and comparing a run against a
# baseline taken on different hardware reports a difference that has nothing to
# do with any change to the library.
/bench/bench
/bench/baseline.json
/bench/.build-flags

# An unnecessary line for triggering a new CI run - 0
