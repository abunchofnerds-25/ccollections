.TH CJSON_DICTIONARY_GET 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
cjson_dictionary_get \- look up a key in an object node
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <cjson.h>

cjson cjson_dictionary_get(cjson obj, const char *key);
.fi
.SH DESCRIPTION
.nf
Returns a non-owning reference to the value associated with key.
.fi
.SH RETURN VALUE
.nf
Child node, or NULL if the key is absent or obj is not CJSON_DICTIONARY.
.fi
.SH "SEE ALSO"
.BR cjson_dictionary_set (3),
.BR cjson_dictionary_size (3)
