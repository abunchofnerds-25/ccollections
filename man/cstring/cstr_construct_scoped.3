.TH CSTR_CONSTRUCT_SCOPED 3 "2026-07-10" "c_collections" "C Collections Library - Macros"
.SH NAME
cstr_construct_scoped \- declare and initialise a cstr with automatic RAII
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/cstring.h>

cstr_construct_scoped(s, initial);
.fi
.SH DESCRIPTION
.nf
This macro combines cstr_declare_scoped() and cstr_init() into one
statement. The program destroys the string automatically when the variable
leaves its scope.
.fi
.SH PARAMETERS
.nf
s        Variable name to create
initial  Initial content (C string or NULL for empty string)
.fi
.SH NOTES
.nf
This macro needs GCC or Clang, because it uses __attribute__((cleanup))
.fi
.SH EXAMPLES
.nf
{
  cstr_construct_scoped(s, "auto-freed");
  /* use s ... */
}  /* the program destroys s here automatically */
.fi
.SH "SEE ALSO"
.BR cstr_construct (3),
.BR cstr_construct_mp_scoped (3)
