.TH CJSON_LIST_GET 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
cjson_list_get \- access an array element by index
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/cjson.h>

cjson cjson_list_get(cjson arr, size_t index);
.fi
.SH DESCRIPTION
.nf
Returns the element at position index of arr.  The array keeps
owning the element, so the reference is borrowed.
.fi
.SH RETURN VALUE
.nf
The child node, or NULL when index is out of bounds or arr is not a
CJSON_LIST.
.fi
.SH "SEE ALSO"
.BR cjson_list_push (3),
.BR cjson_list_len (3)
