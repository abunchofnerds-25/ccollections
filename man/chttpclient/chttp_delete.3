.TH CHTTP_DELETE 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
chttp_delete \- perform a DELETE request via the default client
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <chttpclient.h>

ccol_retval_t chttp_delete(const char *url,
                           chttpcli_response **resp_out);
.fi
.SH DESCRIPTION
.nf
Convenience wrapper for HTTP DELETE.
.fi
.SH RETURN VALUE
.nf
Same codes as chttpclient_do.
.fi
.SH "SEE ALSO"
.BR chttp_get (3),
.BR chttp_do (3)
