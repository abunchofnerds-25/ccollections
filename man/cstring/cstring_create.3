.TH CSTRING_CREATE 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
cstring_create \- create a string with default memory management
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/cstring.h>

cstr cstring_create(const char *initial, char **err);
.fi
.SH DESCRIPTION
.nf
This is cstring_create_full() with the default malloc/free allocators.
.fi
.SH PARAMETERS
.nf
initial   Initial C string content, or NULL for an empty string
err       Optional pointer to receive an error string on failure
.fi
.SH RETURN VALUE
.nf
A pointer to the new cstring on success
NULL on failure, with the details written to *err when err is not NULL
.fi
.SH NOTES
.nf
The call is the same as cstring_create_full(initial, NULL, err)
.fi
.SH "SEE ALSO"
.BR cstring_create_full (3),
.BR cstring_new (3),
.BR cstring_destroy (3)
