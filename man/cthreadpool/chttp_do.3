.TH CHTTP_DO 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
chttp_do \- perform an HTTP request via the default client
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <chttpclient.h>

ccol_retval_t chttp_do(const chttp_request_t *req,
                       chttpcli_response **resp_out);
.fi
.SH DESCRIPTION
.nf
Equivalent to chttpclient_do(chttp_default_client(), req, resp_out).
.fi
.SH RETURN VALUE
.nf
Same codes as chttpclient_do.  Returns ccol_unexpected_failure if the
default client could not be initialised.
.fi
.SH "SEE ALSO"
.BR chttpclient_do (3),
.BR chttp_default_client (3)
