.TH CCOL_MEMPOOL_CALLOC_ENTRY 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
ccol_mempool_calloc_entry \- allocate zero-initialized entry from pool
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <cmempool.h>

void *ccol_mempool_calloc_entry(ccol_mempool *mp);
.fi
.SH DESCRIPTION
.nf
Like ccol_mempool_alloc_entry(), but zeros the entry before returning.
.fi
.SH PARAMETERS
.nf
mp   Memory pool to allocate from
.fi
.SH RETURN VALUE
.nf
Returns pointer to zero-initialized entry on success
Returns NULL if pool exhausted and no fallback enabled
.fi
.SH NOTES
.nf
O(1) complexity
Zeros the whole element
Thread-safe if pool created with single_threaded=false
Will assert if mp is NULL
.fi
.SH "SEE ALSO"
.BR ccol_mempool_alloc_entry (3),
.BR ccol_mempool_free_entry (3)
