.TH CTPOOL_DECLARE 3 "2026-08-02" "c_collections" "C Collections Library - Macros"
.SH NAME
ctpool_declare \- declare an uninitialised thread pool variable
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/cthreadpool.h>

ctpool_declare(name);
.fi
.SH DESCRIPTION
.nf
Expands to `ctpool name` and leaves the variable uninitialized, so you
must assign it with ctpool_create() or ctpool_create_mp() before you
use it.

The macro is there so that the naming matches the other c_collections
modules.
.fi
.SH PARAMETERS
.nf
name  Variable name to declare.
.fi
.SH EXAMPLES
.nf
ctpool_declare(pool);
char *err = NULL;
pool = ctpool_create(4, 128, &err);
if (!pool) { fprintf(stderr, "%s\en", err); exit(1); }
/* ... submit tasks ... */
ctpool_shutdown_drain(pool);
ctpool_destroy(pool);
.fi
.SH "SEE ALSO"
.BR ctpool_declare_scoped (3),
.BR ctpool_construct (3),
.BR ctpool_create (3)
