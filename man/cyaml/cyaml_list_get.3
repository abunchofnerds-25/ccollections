.TH CYAML_LIST_GET 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
cyaml_list_get \- access a list element by index
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/cyaml.h>

cyaml cyaml_list_get(cyaml seq, size_t index);
.fi
.SH DESCRIPTION
.nf
Return a non-owning reference to the child at position index in seq.
.fi
.SH RETURN VALUE
.nf
The child node, or NULL when index is out of bounds or when seq is not a
CYAML_LIST.
.fi
.SH "SEE ALSO"
.BR cyaml_list_push (3),
.BR cyaml_list_len (3)
