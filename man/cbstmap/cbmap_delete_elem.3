.TH CBMAP_DELETE_ELEM 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
cbmap_delete_elem \- remove a key-value pair from the BST map
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <cbstmap.h>

ccol_retval_t cbmap_delete_elem(cbmap cbm, const cmap_pair *key_pair);
.fi
.SH DESCRIPTION
.nf
Removes the key-value pair with the specified key from the BST map.
Frees memory for both key and value. Tree is automatically rebalanced
using AVL rotations after deletion.
.fi
.SH PARAMETERS
.nf
cbm        BST map to remove from
key_pair   Key to remove
.fi
.SH RETURN VALUE
.nf
ccol_success        - Key removed successfully
ccol_key_not_found  - Key does not exist in map
.fi
.SH NOTES
.nf
O(log n) complexity
.fi
.SH "SEE ALSO"
.BR cbmap_remove (3),
.BR cbmap_insert_elem (3)
