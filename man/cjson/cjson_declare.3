.TH CJSON_DECLARE 3 "2026-07-10" "c_collections" "C Collections Library - Macros"
.SH NAME
cjson_declare \- declare an uninitialized cjson variable
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <cjson.h>

cjson_declare(var_name);
.fi
.SH DESCRIPTION
.nf
Expands to `cjson var_name`.  Provided for naming-convention symmetry
with the other container modules.  The variable must be assigned (e.g.
via cjson_parse() or cjson_create_*()) before it is used.
.fi
.SH PARAMETERS
.nf
var_name  Name of the variable to declare.
.fi
.SH EXAMPLES
.nf
cjson_declare(root);
root = cjson_parse("{\e"k\e":1}");
cjson_destroy(root);
.fi
.SH "SEE ALSO"
.BR cjson_declare_scoped (3),
.BR cjson_destroy (3),
.BR cjson_parse (3)
