.TH CYAML_CREATE_INT_MP 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
cyaml_create_int_mp, cyaml_create_int \- allocate a YAML integer node
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <cyaml.h>

cyaml cyaml_create_int_mp(long long val, ccol_memmgmt_procs_t *mp);
cyaml cyaml_create_int(long long val);
.fi
.SH DESCRIPTION
.nf
Allocate a DOM node of type CYAML_INTEGER.  The value is stored
internally as a long long.  cyaml_create_int() passes NULL for mp.
.fi
.SH PARAMETERS
.nf
val  Integer value (any integer type is implicitly converted to
     long long by the caller).
mp   Custom allocator, or NULL for default.
.fi
.SH RETURN VALUE
.nf
New cyaml node on success, NULL on allocation failure.
.fi
.SH "SEE ALSO"
.BR cyaml_int_val (3),
.BR cyaml_destroy (3)
