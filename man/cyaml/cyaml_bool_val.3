.TH CYAML_BOOL_VAL 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
cyaml_bool_val \- extract a boolean value from a CYAML_BOOL node
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <cyaml.h>

bool cyaml_bool_val(cyaml node);
.fi
.SH DESCRIPTION
.nf
Return the C bool stored in node.  Calls fatal_err() if node is NULL
or if its type is not CYAML_BOOL.
.fi
.SH PARAMETERS
.nf
node  CYAML_BOOL node.
.fi
.SH RETURN VALUE
.nf
C bool value.
.fi
.SH "SEE ALSO"
.BR cyaml_type (3),
.BR cyaml_create_bool (3)
