.TH CTHRPOOL_DECLARE 3 "2026-08-02" "c_collections" "C Collections Library - Macros"
.SH NAME
cthrpool_declare \- declare an uninitialised thread pool variable
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/cthreadpool.h>

cthrpool_declare(name);
.fi
.SH DESCRIPTION
.nf
Expands to `cthrpool name` and leaves the variable uninitialized, so you
must assign it with cthrpool_create() or cthrpool_create_mp() before you
use it.

The macro is there so that the naming matches the other c_collections
modules.
.fi
.SH PARAMETERS
.nf
name  Variable name to declare.
.fi
.SH EXAMPLES
.nf
cthrpool_declare(pool);
char *err = NULL;
pool = cthrpool_create(4, 128, &err);
if (!pool) { fprintf(stderr, "%s\en", err); exit(1); }
/* ... submit tasks ... */
cthrpool_shutdown_drain(pool);
cthrpool_destroy(pool);
.fi
.SH "SEE ALSO"
.BR cthrpool_declare_scoped (3),
.BR cthrpool_construct (3),
.BR cthrpool_create (3)
