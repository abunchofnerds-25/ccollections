.TH CTPOOL_PENDING_COUNT 3 "2026-08-02" "c_collections" "C Collections Library - Functions"
.SH NAME
ctpool_pending_count \- number of tasks in the queue
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/cthreadpool.h>

size_t ctpool_pending_count(ctpool pool);
.fi
.SH DESCRIPTION
.nf
Returns a snapshot of how many tasks sit in the task queue, which
means submitted but not picked up by a worker thread yet. The value
can change as soon as the call returns.
.fi
.SH PARAMETERS
.nf
pool   Thread pool handle (CTPOOL_INVALID or a stale/already-destroyed handle returns 0)
.fi
.SH RETURN VALUE
.nf
Number of queued tasks, or 0 if pool is CTPOOL_INVALID or a stale/already-destroyed handle.
.fi
.SH "SEE ALSO"
.BR ctpool_active_count (3)
