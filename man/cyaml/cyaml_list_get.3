.TH CYAML_LIST_GET 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
cyaml_list_get \- access a list element by index
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/cyaml.h>

cyaml cyaml_list_get(cyaml seq, size_t index);
.fi
.SH DESCRIPTION
.nf
Returns the child at position index of seq.  The list keeps owning
the child, so the reference is borrowed.
.fi
.SH RETURN VALUE
.nf
The child node, or NULL when index is out of bounds or seq is not a
CYAML_LIST.
.fi
.SH "SEE ALSO"
.BR cyaml_list_push (3),
.BR cyaml_list_len (3)
