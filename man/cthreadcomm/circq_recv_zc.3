.TH CIRCQ_RECV_ZC 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
circq_recv_zc \- receive a message (blocking)
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <cthreadcomm.h>

ccol_retval_t circq_recv_zc(circular_queue *cq, c_message_t *target_buf);
.fi
.SH DESCRIPTION
.nf
Blocks until a message is available, then transfers ownership of the
message data to the caller via target_buf. The caller must free
target_buf->data when done.
.fi
.SH PARAMETERS
.nf
cq          Circular queue to receive from
target_buf  Buffer to receive the message (receives ownership of data)
.fi
.SH RETURN VALUE
.nf
ccol_success        - Message received (caller must free target_buf->data)
ccol_invalid_args   - cq or target_buf is NULL
.fi
.SH NOTES
.nf
Blocks indefinitely until a message arrives
Remains blocked even when sending is temporarily disabled; unblocks
  when sending is re-enabled and a message arrives
Caller receives ownership of target_buf->data and must free it
Thread-safe
.fi
.SH "SEE ALSO"
.BR circq_try_recv_zc (3),
.BR circq_timed_recv_zc (3),
.BR circq_send_zc (3)
