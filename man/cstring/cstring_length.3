.TH CSTRING_LENGTH 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
cstring_length \- return the number of characters in the string
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/cstring.h>

size_t cstring_length(cstr s);
.fi
.SH DESCRIPTION
.nf
This function returns the number of characters stored in the string,
without the terminating null byte.
.fi
.SH PARAMETERS
.nf
s   String to query
.fi
.SH RETURN VALUE
.nf
The length in bytes, without the null terminator
.fi
.SH NOTES
.nf
Asserts if s is NULL
.fi
.SH "SEE ALSO"
.BR cstring_is_empty (3),
.BR cstring_c_str (3)
