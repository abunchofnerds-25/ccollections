.TH CCOL_R_MEMPOOL_DYNAMIC_ALLOCS_COUNT 3 "2026-07-10" "c_collections" "C Collections Library - Functions"
.SH NAME
ccol_r_mempool_dynamic_allocs_count \- get number of dynamic allocations
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <ccollections/cmempool.h>

size_t ccol_r_mempool_dynamic_allocs_count(ccol_r_mempool *rmp, size_t size);
.fi
.SH DESCRIPTION
.nf
Returns the number of heap entries for the given size. The behavior
depends on the fallback policy.
.fi
.SH PARAMETERS
.nf
rmp   Ranged memory pool to query
size  Size in bytes to query
.fi
.SH RETURN VALUE
.nf
Returns the number of dynamic entries
Returns 0 on an error, and 0 when the fallback is off
.fi
.SH NOTES
.nf
Returns 0 for ccol_fallback_disabled
With ccol_fallback_at_first_exhaustion, the function tracks the dynamic
entries of each pool
With ccol_fallback_at_last_exhaustion, the function tracks every dynamic
entry
Returns 0 if the size is invalid
Thread-safe if the pool was created with single_threaded=false
.fi
.SH "SEE ALSO"
.BR ccol_r_mempool_used_count (3),
.BR ccol_r_mempool_total_capacity (3)
