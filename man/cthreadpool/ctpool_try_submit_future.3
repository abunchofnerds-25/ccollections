.TH CTPOOL_TRY_SUBMIT_FUTURE 3 "2026-08-02" "c_collections" "C Collections Library - Functions"
.SH NAME
ctpool_try_submit_future \- submit a future task without blocking
.SH LIBRARY
C Collections (libccollections, \-lccollections)
.SH SYNOPSIS
.nf
#include <cthreadpool.h>

ccol_retval_t ctpool_try_submit_future(ctpool pool,
                                       void *(*fn)(void *),
                                       void *arg,
                                       ctpool_future **out);
.fi
.SH DESCRIPTION
.nf
Allocates a future and submits it to the pool without blocking. If a
bounded queue is at capacity the function returns ccol_container_full
immediately and sets *out to NULL. For unbounded queues the behaviour
is identical to ctpool_submit_future.

On success *out is set to a new ctpool_future handle with a reference
count of 2 (caller + queued task). The caller must call
ctpool_future_free exactly once when done.
.fi
.SH PARAMETERS
.nf
pool  Thread pool handle
fn    Task function returning void* (must not be NULL)
arg   Passed to fn (may be NULL)
out   Receives the future handle on success; set to NULL on failure
      (must not be NULL)
.fi
.SH RETURN VALUE
.nf
ccol_success           - task enqueued; *out set to the future handle.
ccol_invalid_args      - pool is CTPOOL_INVALID or a stale/already-destroyed handle, or fn or out is NULL.
ccol_not_enough_memory - future or task allocation failed.
ccol_not_permitted     - pool is shutting down.
ccol_container_full    - bounded queue is at capacity.
.fi
.SH "SEE ALSO"
.BR ctpool_submit_future (3),
.BR ctpool_timed_submit_future (3),
.BR ctpool_future_get (3),
.BR ctpool_future_free (3)
