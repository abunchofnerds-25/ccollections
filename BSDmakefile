# FreeBSD's make picks up this file before Makefile. The build needs GNU make
# (pkg install gmake), so all the targets here do is say that and fail.
all:
	@echo "c_collections needs GNU make: run gmake instead of make." >&2; exit 1
.DEFAULT:
	@echo "c_collections needs GNU make: run gmake instead of make." >&2; exit 1
